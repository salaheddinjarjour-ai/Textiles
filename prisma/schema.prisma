// TextileHub ERP — data model
// SQLite for local dev. Note: SQLite has no native enums, so status/role
// fields are Strings validated at the application layer (see src/lib/rbac.ts
// and src/lib/constants.ts).

generator client {
  provider        = "prisma-client-js"
  // Required to run against Cloudflare D1 via @prisma/adapter-d1.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  role           String // ADMIN | MANAGER | SALES | WAREHOUSE | ACCOUNTANT
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  salesOrders    SalesOrder[]
  purchaseOrders PurchaseOrder[]
}

model Warehouse {
  id       String  @id @default(cuid())
  name     String
  location String?
  stock    Stock[]
}

model Product {
  id            String              @id @default(cuid())
  name          String
  sku           String              @unique
  category      String // Cotton | Linen | Denim | Satin | Polyester | Silk | Wool
  unit          String // Roll | Meter | Yard
  color         String?
  costPrice     Float               @default(0)
  sellPrice     Float               @default(0)
  reorderLevel  Int                 @default(0)
  active        Boolean             @default(true)
  createdAt     DateTime            @default(now())
  stock         Stock[]
  saleItems     SalesOrderItem[]
  purchaseItems PurchaseOrderItem[]
}

model Stock {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  lotNumber   String
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt
}

model Customer {
  id          String       @id @default(cuid())
  name        String
  company     String?
  email       String?
  phone       String?
  address     String?
  city        String?
  country     String?      @default("USA")
  createdAt   DateTime     @default(now())
  salesOrders SalesOrder[]
  invoices    Invoice[]
  payments    Payment[]
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  company        String?
  email          String?
  phone          String?
  address        String?
  createdAt      DateTime        @default(now())
  purchaseOrders PurchaseOrder[]
}

model SalesOrder {
  id          String           @id @default(cuid())
  orderNumber String           @unique
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id])
  status      String           @default("PENDING") // PENDING | PROCESSING | COMPLETED | CANCELLED
  subtotal    Float            @default(0)
  taxRate     Float            @default(0)
  taxAmount   Float            @default(0)
  total       Float            @default(0)
  notes       String?
  createdById String?
  createdBy   User?            @relation(fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  items       SalesOrderItem[]
  invoice     Invoice?
}

model SalesOrderItem {
  id        String     @id @default(cuid())
  orderId   String
  order     SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product    @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  unitCost  Float      @default(0)
  lineTotal Float
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  poNumber    String              @unique
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  status      String              @default("PENDING") // PENDING | RECEIVED | CANCELLED
  total       Float               @default(0)
  createdById String?
  createdBy   User?               @relation(fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())
  items       PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id        String        @id @default(cuid())
  poId      String
  po        PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Int
  unitCost  Float
  lineTotal Float
}

model Invoice {
  id            String      @id @default(cuid())
  invoiceNumber String      @unique
  salesOrderId  String?     @unique
  salesOrder    SalesOrder? @relation(fields: [salesOrderId], references: [id])
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  amount        Float
  amountPaid    Float       @default(0)
  status        String      @default("UNPAID") // UNPAID | PARTIAL | PAID
  issueDate     DateTime    @default(now())
  dueDate       DateTime?
  payments      Payment[]
}

model Payment {
  id         String   @id @default(cuid())
  invoiceId  String?
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  amount     Float
  method     String   @default("Bank Transfer")
  reference  String?
  receivedAt DateTime @default(now())
}

model Transaction {
  id          String   @id @default(cuid())
  type        String // INCOME | EXPENSE
  category    String
  description String?
  amount      Float
  date        DateTime @default(now())
}
